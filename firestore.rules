rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /houses/{houseId} {
      allow read, write: if true;
    }

    match /bookings/{bookingId} {
      allow read, write: if true;
    }

    match /expenses/{expenseId} {
      allow read, write: if true;
    }

    match /todos/{todoId} {
      allow read, write: if true;
    }

    match /reviews/{reviewId} {
      allow read, write: if true;
    }
  }
}
